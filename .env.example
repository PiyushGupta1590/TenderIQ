# TenderIQ Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Create the database first: CREATE DATABASE tenderiq;
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tenderiq

# ── OCR Engine ────────────────────────────────────────────────────────────────
# tesseract (default, local) or google (requires GOOGLE_API_KEY)
OCR_ENGINE=tesseract

# Tesseract executable path (Windows default)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── AI Provider ───────────────────────────────────────────────────────────────
# none (heuristic, default) or gemini (requires GOOGLE_API_KEY)
AI_PROVIDER=none

# Google Gemini API Key (optional — only needed for AI_PROVIDER=gemini)
GOOGLE_API_KEY=

# ── Evaluation Thresholds ─────────────────────────────────────────────────────
# Confidence threshold below which a field triggers MANUAL_REVIEW
CONFIDENCE_THRESHOLD=0.75

# Borderline margin: values within this % of the limit trigger MANUAL_REVIEW
BORDERLINE_MARGIN=0.05

# ── Storage ───────────────────────────────────────────────────────────────────
# Local folder for uploaded PDFs and generated reports (relative to project root)
DATA_DIR=data
