# TenderIQ Production Environment Configuration
# Copy this file to .env for production deployment

# ── Database ──────────────────────────────────────────────────────────────────
# For Render PostgreSQL, use the Internal Database URL provided
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/tenderiq
DB_PASSWORD=your_secure_password_here

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Add your production frontend URL for CORS
FRONTEND_URL=https://your-app.onrender.com

# ── OCR Engine ────────────────────────────────────────────────────────────────
OCR_ENGINE=tesseract
TESSERACT_PATH=/usr/bin/tesseract

# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: none (heuristic, default) or gemini (requires GOOGLE_API_KEY)
AI_PROVIDER=none

# ── API Keys (Optional) ───────────────────────────────────────────────────────
# Groq API Key for LLM-based extraction (free tier available)
GROQ_API_KEY=

# Google Gemini API Key (optional)
GOOGLE_API_KEY=

# ── Evaluation Thresholds ─────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.75
BORDERLINE_MARGIN=0.05
LLM_HIGH_CONF=0.85
LLM_MED_CONF=0.60

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=data
