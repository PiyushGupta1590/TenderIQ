# TenderIQ Backend — Environment Variables
# Copy this to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tenderiq

# ── Directories ───────────────────────────────────────────────────────────────
DATA_DIR=data

# ── OCR ───────────────────────────────────────────────────────────────────────
# Path to Tesseract executable (Windows example shown; Linux: /usr/bin/tesseract)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_ENGINE=tesseract

# ── LLM Hybrid Extraction (OPTIONAL but recommended) ─────────────────────────
#
# Set at least ONE of these to unlock the hybrid extraction pipeline.
# Without a key the system runs in regex-only mode (original behaviour).
#
# Option A: Groq (FREE, fast, recommended)
#   Sign up at https://console.groq.com → API Keys → Create key
GROQ_API_KEY=

# Option B: Google Gemini 1.5 Flash (FREE tier)
#   Sign up at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Confidence Thresholds (hybrid pipeline) ───────────────────────────────────
# >= LLM_HIGH_CONF  -> accept regex result as-is (no LLM call)
# LLM_MED_CONF to LLM_HIGH_CONF -> LLM verify / sanity-check regex
# < LLM_MED_CONF   -> LLM extracts from scratch
LLM_HIGH_CONF=0.85
LLM_MED_CONF=0.60

# ── Evaluation Engine ─────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.75
BORDERLINE_MARGIN=0.05
